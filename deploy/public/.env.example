# Dışarıya açık sunucu ayarları. Bu dosyayı .env olarak kopyalayıp doldurun (.env git'e girmez).

# Kapalı ağdaki veritabanı (güvenlik duvarında bu sunucunun IP'sine 5432 izni açılır)
DB_URL=jdbc:postgresql://10.0.5.20:5432/mezunkart
# Mümkünse internal'dan ayrı, daha az yetkili bir veritabanı kullanıcısı (bkz. deploy/README.md)
DB_USERNAME=mezunkart
DB_PASSWORD=change-me
DB_SCHEMA=mezunkart

# JWT anahtarları ./keys/private.pem ve ./keys/public.pem (bkz. deploy/README.md). Internal sunucununkinden farklı olmalı.
JWT_KEY_ID=public-key-1

# Container'ın dinlediği adres; TLS'i önündeki reverse proxy yapar
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
