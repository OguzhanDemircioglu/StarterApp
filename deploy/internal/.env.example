# Kapalı ağ sunucusu ayarları. Bu dosyayı .env olarak kopyalayıp doldurun (.env git'e girmez).

# Veritabanı (bu sunucuda çalışır)
DB_NAME=mezunkart
DB_USERNAME=mezunkart
DB_PASSWORD=change-me
DB_SCHEMA=mezunkart
# Public sunucu veritabanına bağlanacaksa: kapalı ağdaki arayüzün IP'si (ör. 10.0.5.20). Varsayılan sadece bu makine.
DB_BIND_ADDRESS=127.0.0.1

# İlk açılışta oluşturulan süper yönetici (sadece sistemde hiç yönetici yoksa kullanılır)
ADMIN_EMAIL=superadmin@kurum.gov.tr
ADMIN_PASSWORD=change-me-strong-password

# JWT anahtarları ./keys/private.pem ve ./keys/public.pem (bkz. deploy/README.md). Public sunucununkinden farklı olmalı.
JWT_KEY_ID=internal-key-1

# Yönetim panelinin dinlediği adres (kapalı ağdaki IP ya da önünde reverse proxy varsa 127.0.0.1)
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Kapalı ağda HTTPS yoksa false (cookie'ler aksi halde gönderilmez)
COOKIE_SECURE=true
