# deploy/.env olarak kopyalanır ve doldurulur. .env git'e girmez. Ayrıntı: deploy/README.md

# Container, volume ve ağ adlarının ön eki. Aynı sunucuda birden fazla proje varsa her biri farklı olmalı.
COMPOSE_PROJECT_NAME=starterapp

# Log toplama eklentisini açmak için alttaki satırın başındaki # kaldırılır (README → Loglar).
# COMPOSE_FILE=compose.yml:compose.observability.yml

# Uygulamanın (client nginx) yayınlandığı adres. Varsayılan sadece sunucunun kendisinden erişim: önüne HTTPS yapan
# bir reverse proxy konur. Reverse proxy başka bir makinedeyse HTTP_BIND=0.0.0.0 yapılır.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=starterapp
POSTGRES_USER=starterapp
POSTGRES_PASSWORD=change-me
# Uygulamanın tabloları bu şemada durur (küçük harf).
DB_SCHEMA=starterapp

# deploy/keys/ içindeki anahtarın kimliği; anahtar değiştirilince değiştirilir.
JWT_KEY_ID=key-2026-11

# Sadece ilk açılışta, sistemde hiç admin yoksa kullanılır.
ADMIN_EMAIL=admin@firma.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Sadece log eklentisi açıksa ----
GRAFANA_ADMIN_PASSWORD=change-me
# Loki'de log saklama süresi (saat). 720h = 30 gün.
LOG_RETENTION=720h
