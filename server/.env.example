# Prod ortamı için environment variable listesi. Gerçek değerler bu dosyaya değil, sunucudaki .env'e
# ya da Docker secret'larına yazılır. Ayrıntı: docs/Backend_Architecture.md §15
# Template'in Docker Compose kurulumu (deploy/) bu değişkenleri deploy/.env'den kendisi kurar; bu dosya o durumda
# sadece başvuru içindir.

SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://db-host:5432/starterapp
DB_USERNAME=starterapp
DB_PASSWORD=change-me
# Uygulamanın tabloları bu şemada durur (küçük harf). Paylaşılan veritabanlarında diğer şemalara dokunulmaz.
DB_SCHEMA=starterapp

# RS256 anahtarları (Swarm'da Docker secret olarak verilir; bütün replica'lar aynı anahtarı kullanır)
JWT_KEY_ID=key-2026-10
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
# Anahtar değişimi sırasında bir önceki public key (isteğe bağlı)
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY_PATH=

# Sadece ilk açılışta, sistemde hiç admin yoksa kullanılır
ADMIN_EMAIL=admin@firma.com
ADMIN_PASSWORD=change-me-strong-password

# Frontend farklı bir origin'deyse virgülle ayrılmış liste; aynı origin'deyse boş bırakılır
CORS_ALLOWED_ORIGINS=https://app.firma.com
COOKIE_SECURE=true

# Reverse proxy arkasındaysa native (gerçek istemci IP'si X-Forwarded-For'dan okunur)
FORWARD_HEADERS_STRATEGY=none
