# KAPALI AĞ yüzeyi (SURFACE=internal): sadece yönetim paneli (ADMIN, SUPERADMIN).
# Angular dosyalarını sunar ve /api isteklerini aynı yüzeydeki server'a (APP_SURFACE=internal) iletir.
# Kayıt ve portal API'si burada hiç verilmez; server da aynı yolları kapatır (iki katmanlı koruma).
# ${API_UPSTREAM} container açılırken ortam değişkeninden doldurulur (nginx imajının templates özelliği).
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Bu yüzeyde olmayan ve sadece geliştirmede kullanılan yollar.
    location = /api/auth/register {
        return 404;
    }

    location /api/portal/ {
        return 404;
    }

    location = /api/auth/dev-login {
        return 404;
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
    }

    location /i18n/ {
        add_header Cache-Control "no-cache";
    }

    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: bilinmeyen her yol index.html'e düşer (ör. /admin/definitions/categories sayfasında F5).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
